<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.paras.tailbridge"
	android:versionCode="1"
	android:versionName="1.0.0">

	<!--
  Taildrop arrival alerts. Android 13 (API 33) made this a runtime permission,
  and without it NotificationManager.notify() is silently dropped: the
  broadcast reaches ReceiveNotifier, the process starts, and no alert appears.
  This app targets 34, so declaring it is not enough on its own; MainActivity
  also has to ask, which it does on launch.
-->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!--
  Package visibility (API 30+). Without this, getLaunchIntentForPackage() returns
  null for every root manager and the "grant root permission" gate silently
  falls through to Android app settings, which is not where superuser
  permission lives.
-->
<queries>
	<package android:name="com.resukisu.resukisu" />
	<package android:name="me.weishu.kernelsu" />
	<package android:name="com.topjohnwu.magisk" />
	<package android:name="me.bmax.apatch" />
	<package android:name="eu.chainfire.supersu" />
	<package android:name="com.noshufou.android.su" />
	<package android:name="com.koushikdutta.supertool" />
	<intent>
		<action android:name="android.intent.action.VIEW" />
		<data android:scheme="https" />
	</intent>
</queries>

<application
		android:label="@string/app_name"
		android:icon="@drawable/ic_launcher"
		android:theme="@style/Theme.Share"
		android:allowBackup="false"
		android:supportsRtl="true">

		<!--
		  One activity for everything.

		  noHistory, excludeFromRecents and an empty taskAffinity exist for the
		  share path. Tapping this in another app's share sheet has to start an
		  activity. That is the platform, not a choice here, so the best that
		  can be done is make it leave no trace: it does not appear in recents,
		  it does not join the sending app's task, and it is gone the moment it
		  closes. What remains is a translucent window over the app you shared
		  from, which stays on screen behind the device picker.

		  Rendering the picker inside the sheet itself would need
		  android.service.chooser.ChooserTargetService, which is a hidden API
		  absent from the public SDK. Compiling against a hand-made stub of it
		  risks the class colliding with the platform's own at runtime, so it is
		  not worth it to save an animation.

		  It is both the launcher icon and the share target, so "Share to
		  Tailscale" from Gallery, Files or a browser lands on the same Send
		  screen the app already uses — there is no separate share UI and no
		  intermediate dialog.

		  This is the whole point of the app: the Play Store Tailscale app
		  registers this share entry, but it owns the VpnService slot. This
		  module deliberately does NOT use VpnService (tailscaled runs in
		  userspace mode so another VPN app can run alongside), so without a
		  share-target app there is no way to send a file at all.
		-->
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTask"
			android:configChanges="uiMode|orientation|screenSize|keyboardHidden"
			android:taskAffinity=""
			android:noHistory="true"
			android:excludeFromRecents="true"
			android:label="@string/app_name">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>

			<!-- share target: one file -->
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*" />
			</intent-filter>

			<!-- share target: several files -->
			<intent-filter>
				<action android:name="android.intent.action.SEND_MULTIPLE" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<meta-data
				android:name="android.app.direct_share"
				android:resource="@xml/direct_share_targets" />
		</activity>

		<!-- Backs the direct-share target above. BIND_CHOOSER_TARGET_SERVICE is
		     what lets the system chooser bind it and nothing else. -->
		<service
			android:name=".ShareTargetService"
			android:exported="true"
			android:permission="android.permission.BIND_CHOOSER_TARGET_SERVICE">
			<intent-filter>
				<action android:name="android.service.chooser.CHOOSER_TARGET_SERVICE" />
			</intent-filter>
		</service>

		<!--Taildrop arrival alerts.
		     exported because the receiver script runs as root, outside the app,
		     and hands the delivery over an explicit broadcast. Without this the
		     only alert is `cmd notification post`, which cannot carry a button
		     and does not survive in the shade.
		     -->
		<receiver
			android:name=".ReceiveNotifier"
			android:exported="true"
			android:permission="android.permission.DUMP">
			<intent-filter>
				<action android:name="com.paras.tailbridge.RECEIVED" />
			</intent-filter>
		</receiver>
		<!--Serves received files to whatever app opens them. A document URI
		     cannot be used without a SAF grant, so the notification's Open
		     action goes through a provider we own instead. grantUriPermissions
		     is what makes the hand-off legal. -->
		<provider
			android:name=".FilesProvider"
			android:authorities="com.paras.tailbridge.files"
			android:exported="false"
			android:grantUriPermissions="true" />

		<!--Exposes Download/Tailscale to the system file browser, which is
		     what lets "Open folder" land in Files at that folder. -->
		<provider
			android:name=".TailscaleDocuments"
			android:authorities="com.paras.tailbridge.docs"
			android:exported="true"
			android:grantUriPermissions="true"
			android:permission="android.permission.MANAGE_DOCUMENTS" />

	</application>
</manifest>
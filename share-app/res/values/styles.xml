<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="Theme.Share" parent="@android:style/Theme.Material.NoActionBar">
		<item name="android:windowBackground">@color/bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlActivated">@color/accent</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@color/bg</item>
		<item name="android:windowLightStatusBar">false</item>
	</style>

	<!-- Share-sheet launch.

	     Sharing a file opened the whole app: a zoom-in transition, the Send tab,
	     a header, a nav bar, and the device picker floating on top of all it. It
	     read as being redirected into an app rather than using one.

	     A translucent window is what removes the redirect feeling, because the
	     system fades it in rather than animating an activity coming forward. The
	     window is transparent and nothing is painted behind the picker, so the
	     app you shared from stays on screen behind it. -->
	<style name="Theme.Share.Popup" parent="@android:style/Theme.Material.Dialog">
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:backgroundDimEnabled">false</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
	</style>

	<!-- Dialogs use the app's own surface and outline so they do not read as a
	     different, older dialog dropped on top of a modern screen. -->
	<style name="Theme.Share.Dialog" parent="@android:style/Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlActivated">@color/accent</item>
		<item name="android:backgroundDimAmount">0.66</item>
		<item name="android:textColorPrimary">@color/text</item>
		<item name="android:textColorSecondary">@color/text2</item>
	</style>

	<!-- ── bottom nav ───────────────────────────────────────────── -->
	<style name="Nav">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_weight">1</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:orientation">vertical</item>
		<item name="android:gravity">center</item>
		<item name="android:background">?android:attr/selectableItemBackground</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
	</style>

	<style name="NavIcon">
		<item name="android:layout_width">23dp</item>
		<item name="android:layout_height">23dp</item>
	</style>

	<style name="NavLabel">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">5dp</item>
		<item name="android:textSize">10sp</item>
		<item name="android:textColor">@color/hint</item>
		<item name="android:singleLine">true</item>
	</style>

	<!-- ── text ─────────────────────────────────────────────────── -->

</resources>
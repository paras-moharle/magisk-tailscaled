<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct Share target.

  Without this TailBridge only exists inside the share sheet's overflow, one
  level down, and choosing it starts an activity: the system animates it to the
  foreground and pushes the app you shared from into the background. A direct
  target is rendered by the sheet itself, so the device picker appears over the
  app you never left.

  Only android:name is valid on a target. A direct-share target cannot filter
  by mime type; it is offered for whatever the sheet is already sending.
-->
<share-targets xmlns:android="http://schemas.android.com/apk/res/android">
	<target android:name="com.paras.tailbridge.ShareTargetService" />
</share-targets>

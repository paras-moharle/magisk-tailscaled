#!/usr/bin/env bash
# taildrop-receiver — collect Taildrop deliveries into a folder, automatically.
#
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 paras-moharle
#
# ── What the daemon actually does ───────────────────────────────────────────
#
# A current tailscaled does not stage incoming files anywhere a receiver can
# pull them. `tailscale file get` still returns 0 while collecting nothing, so
# a get-loop reports "no files" forever and delivers nothing: the file is
# sitting in the download directory the whole time, and the sender was told it
# worked.
#
# The daemon writes deliveries straight into the download directory, so this
# watches that directory instead of an inbox that never fills.
#
# ── Why it compares against a snapshot rather than moving everything ────────
#
# On a phone the delivery folder is dedicated, so "everything in it is new"
# is true and moving whatever is found is safe. On a desktop it is the user's
# own Downloads, full of their own files, and sweeping it would carry their
# downloads away.
#
# So a file is collected when it is present now and was not present last time.
# The snapshot is kept on disk, which means a delivery that arrived while this
# was not running is still collected on the next start, and a file that merely
# failed to move is still known and is not retried or re-announced forever.
set -uo pipefail

DEST="${TAILDROP_DEST:-$HOME/Downloads/Tailscale}"
DROP_DIR="${TAILDROP_DROP_DIR:-$HOME/Downloads}"
STATE_DIR="${TAILDROP_STATE:-$HOME/.local/state/taildrop-receiver}"
SNAPSHOT="$STATE_DIR/dropdir.snapshot"
INTERVAL="${TAILDROP_INTERVAL:-5}"
CLI="${TAILDROP_CLI:-tailscale}"

log() { printf '%s taildrop-receiver: %s\n' "$(date -Is)" "$*"; }

if ! command -v "$CLI" >/dev/null 2>&1; then
    log "no '$CLI' on PATH; exiting"
    exit 127
fi

mkdir -p "$DEST" "$STATE_DIR" || { log "cannot create state directories"; exit 1; }

# The daemon may not be up yet at boot, so wait for a usable backend rather
# than spinning against a socket that is not listening.
state=""
for _ in $(seq 1 60); do
    state="$($CLI status --json 2>/dev/null | grep -o '"BackendState": *"[^"]*"' | cut -d'"' -f4)"
    case "$state" in
        Running) break ;;
        NeedsLogin)
            log "tailnet needs login; run 'tailscale up' (or open the app)"
            exit 0
            ;;
    esac
    sleep 2
done

if [ "${state:-}" != "Running" ]; then
    log "daemon not ready (state=${state:-unknown}); exiting"
    exit 1
fi

# Name plus mtime. The mtime is what tells a re-sent file apart from the copy
# already collected, so the same filename sent twice is collected twice.
listing() {
    [ -d "$DROP_DIR" ] || return 0
    find "$DROP_DIR" -maxdepth 1 -type f -printf '%f\t%T@\n' 2>/dev/null | sort
}

# First run: adopt whatever is already there. Those are the user's own files,
# not deliveries, and collecting them would be the worst possible first act.
if [ ! -f "$SNAPSHOT" ]; then
    listing > "$SNAPSHOT" || { log "cannot write $SNAPSHOT"; exit 1; }
    log "first run: adopted $(wc -l < "$SNAPSHOT") existing file(s) in $DROP_DIR"
fi

log "watching $DROP_DIR -> $DEST (every ${INTERVAL}s)"

# Move one file into DEST, never clobbering a file already there.
collect() {
    _src="$1"
    _base="$(basename "$_src")"
    _dst="$DEST/$_base"
    if [ -e "$_dst" ]; then
        _stem="${_base%.*}"
        _ext=""
        case "$_base" in *.*) _ext=".${_base##*.}" ;; esac
        _n=1
        while [ -e "${DEST}/${_stem}-${_n}${_ext}" ]; do
            _n=$((_n + 1))
        done
        _dst="${DEST}/${_stem}-${_n}${_ext}"
    fi
    mv -f "$_src" "$_dst" 2>/dev/null && printf '%s' "$_dst"
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "Taildrop" "Received $1 file(s)" "$2 — $DEST"
}

while :; do
    current="$(listing)"
    if [ -n "$current" ]; then
        new="$(comm -13 <(sort "$SNAPSHOT" 2>/dev/null) <(printf '%s\n' "$current"))"
        if [ -n "$new" ]; then
            count=0
            names=""
            while IFS= read -r entry; do
                [ -n "$entry" ] || continue
                name="${entry%%$'\t'*}"
                [ -n "$name" ] || continue
                src="${DROP_DIR}/${name}"
                [ -f "$src" ] || continue
                if out="$(collect "$src")" && [ -n "$out" ]; then
                    count=$((count + 1))
                    names="${names}${names:+, }$name"
                    log "received $count: $name -> $out"
                else
                    # Leave the snapshot saying it is known, so a file that
                    # cannot be moved is not retried and re-announced forever.
                    log "could not collect $name; leaving it in place"
                fi
            done <<< "$new"
            [ "$count" -gt 0 ] && notify "$count" "$names"
        fi
        # Whatever is there now is the new baseline, including anything that
        # failed to move: it is still known.
        printf '%s\n' "$current" > "$SNAPSHOT.tmp" 2>/dev/null &&
            mv -f "$SNAPSHOT.tmp" "$SNAPSHOT" 2>/dev/null || true
    fi

    sleep "$INTERVAL"
done
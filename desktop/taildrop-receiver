#!/usr/bin/env bash
# taildrop-receiver — collect Taildrop deliveries into a folder, automatically.
#
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 paras-moharle
#
# ── Why this fetches ────────────────────────────────────────────────────────
#
# Linux and Android tailscaled do not behave the same way here.
#
# On Android the daemon writes each delivery straight into
# /sdcard/Download/Taildrop and there is nothing to fetch; the receiver only
# has to notice and move it.
#
# On Linux the delivery is held by the daemon and `tailscale file cp` returns
# success without delivering anything until somebody calls
# `tailscale file get`. This receiver was once rewritten to watch the download
# directory directly, on the assumption that both platforms behaved like
# Android. On Linux that assumption is false: the daemon never writes there,
# so the receiver waited forever for a file that was never coming, while
# `tailscale file cp` cheerfully reported success. Symptom: the sender is told
# it worked, and nothing arrives.
#
# So: fetch into a staging directory we own, then move the results out.
#
# ── Why presence is the whole test ──────────────────────────────────────────
#
# Each file is moved out of staging as it is collected, so anything still
# there has not been delivered yet.
#
# A seen-list keyed on filename was tried and was wrong: once a name had been
# seen, every later delivery of that name was skipped forever, so sending the
# same file twice silently stopped working. Keying on size and mtime did not
# help either, because re-sending the same file produces identical bytes with
# the same timestamp. Staging is ours and dedicated, so "everything present is
# unhandled" is true and there is nothing to track.
set -uo pipefail

DEST="${TAILDROP_DEST:-$HOME/Downloads/Tailscale}"
STATE_DIR="${TAILDROP_STATE:-$HOME/.local/state/taildrop-receiver}"
STAGING="${TAILDROP_STAGING:-$STATE_DIR/staging}"
STUCK_FILE="$STATE_DIR/stuck.list"
INTERVAL="${TAILDROP_INTERVAL:-5}"
CLI="${TAILDROP_CLI:-tailscale}"

log() { printf '%s taildrop-receiver: %s\n' "$(date -Is)" "$*"; }

if ! command -v "$CLI" >/dev/null 2>&1; then
    log "no '$CLI' on PATH; exiting"
    exit 127
fi

mkdir -p "$DEST" "$STAGING" "$STATE_DIR" || { log "cannot create directories"; exit 1; }

# The daemon may not be up yet at boot, so wait for a usable backend rather
# than spinning against a socket that is not listening.
state=""
for _ in $(seq 1 60); do
    state="$($CLI status --json 2>/dev/null | grep -o '"BackendState": *"[^"]*"' | cut -d'"' -f4)"
    case "$state" in
        Running) break ;;
        NeedsLogin)
            log "tailnet needs login; run 'tailscale up' (or open the app)"
            exit 0
            ;;
    esac
    sleep 2
done

if [ "${state:-}" != "Running" ]; then
    log "daemon not ready (state=${state:-unknown}); exiting"
    exit 1
fi

# Anything already staged arrived while we were down and is still waiting.
for f in "$STAGING"/*; do
    [ -f "$f" ] && log "picked up from a previous run: $(basename "$f")"
done

log "fetching Taildrop into $STAGING -> $DEST (every ${INTERVAL}s)"

# Move one file into DEST without ever clobbering a file already there.
collect() {
    _src="$1"
    _base="$(basename "$_src")"
    _dst="$DEST/$_base"
    if [ -e "$_dst" ]; then
        _stem="${_base%.*}"
        _ext=""
        case "$_base" in *.*) _ext=".${_base##*.}" ;; esac
        _n=1
        while [ -e "${DEST}/${_stem}-${_n}${_ext}" ]; do
            _n=$((_n + 1))
        done
        _dst="${DEST}/${_stem}-${_n}${_ext}"
    fi
    mv -f "$_src" "$_dst" 2>/dev/null && printf '%s' "$_dst"
}

# A file we could not move out. Said once, not once per poll.
note_stuck() {
    _k="$(basename "$1")"
    if [ -f "$STUCK_FILE" ] && grep -Fxq -- "$_k" "$STUCK_FILE" 2>/dev/null; then
        return 0
    fi
    printf '%s\n' "$_k" >> "$STUCK_FILE" 2>/dev/null || true
    log "could not collect $_k; it stays in $STAGING"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Taildrop" "Taildrop: could not store $_k" "$STAGING"
    fi
}

sweep() {
    count=0
    names=""
    for f in "$STAGING"/*; do
        [ -f "$f" ] || continue
        if out="$(collect "$f")" && [ -n "$out" ]; then
            count=$((count + 1))
            names="${names}${names:+, }$(basename "$f")"
            log "collected $count: $(basename "$f") -> $out"
        else
            note_stuck "$f"
        fi
    done
    if [ "$count" -gt 0 ]; then
        _sum="$(printf '%s' "$names" | cut -d, -f1-3 | sed 's/, */, /g')"
        [ "$count" -gt 3 ] && _sum="$_sum, and $((count - 3)) more"
        if command -v notify-send >/dev/null 2>&1; then
            if notify-send -a "Taildrop" -u critical \
                    "Received $count file(s)" "$_sum — $DEST"; then
                log "notified: $_sum"
            else
                log "notify-send FAILED (exit $?) for: $_sum"
            fi
        else
            log "notify-send is not installed; no alert was shown"
        fi
    fi
}

# Anything left from a previous run is collected before the first fetch.
sweep

while :; do
    # `file get` returns 0 whether or not anything was waiting, so its status
    # is not a signal; the sweep above is what decides.
    timeout 60 "$CLI" file get --conflict=rename "$STAGING" >/dev/null 2>&1 || true
    sweep
    sleep "$INTERVAL"
done